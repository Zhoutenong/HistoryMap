{
  "name": "history-map",
  "version": "0.1.0",
  "description": "中国历史地图 · 前后端解耦版（Express + SQLite 后端 + three.js 前端）",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "contract": "node scripts/contract.mjs && node scripts/gen-contract-tokens.mjs --check",
    "contract:golden": "node scripts/contract-golden.mjs",
    "contract:db-migration": "node scripts/db-migration-contract.mjs",
    "contract:tokens": "node scripts/gen-contract-tokens.mjs --check",
    "contract:tokens:write": "node scripts/gen-contract-tokens.mjs --write",
    "lint": "eslint client/src server scripts",
    "test": "npm --prefix client run test",
    "check:build": "node scripts/check-build.mjs",
    "check:tokens": "node scripts/check-visual-tokens.mjs",
    "data:classics": "node scripts/fetch-jiuyuzhi.mjs && node scripts/fetch-yudi-guangji.mjs",
    "data:seats": "node scripts/fetch-chgis-song.mjs",
    "data:prefectures": "node scripts/build-song-prefectures.mjs",
    "bake:textures": "node scripts/bake-overlay-textures.mjs",
    "penpot:svg": "node scripts/penpot-prepare-svg.mjs",
    "penpot:render": "node scripts/penpot-render-textures.mjs",
    "masks:generate": "node scripts/generate-masks.mjs",
    "data:check": "node scripts/check-prefectures.mjs",
    "data:songshi": "node scripts/fetch-songshi-dili.mjs && node scripts/extract-place-events.mjs",
    "data:temporal": "node scripts/build-temporal-db.mjs",
    "data:temporal:check": "node scripts/check-temporal.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.6",
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.0.0",
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "opencc-js": "^1.4.1",
    "polygon-clipping": "^0.15.7"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
